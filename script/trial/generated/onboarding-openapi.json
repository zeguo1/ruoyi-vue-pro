              "PROVISIONING",
              "READY",
              "REVOKING",
              "EXPIRED"
            ]
          },
          "accountReady": {
            "type": "boolean",
            "default": false,
            "description": "整套账号就绪条件；过期时始终为 false"
          },
          "expiresAt": {
            "type": "string",
            "description": "实际截止时间，ISO-8601 UTC"
