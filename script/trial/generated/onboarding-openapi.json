            "items": {
              "$ref": "#/components/schemas/cn.iocoder.yudao.module.crm.controller.admin.trial.vo.TrialStatusRespVO.StepProgress"
            }
          },
          "nextAction": {
            "type": "string",
            "description": "下一步说明"
          },
          "cardType": {
            "type": "string",
            "description": "安全卡片类型，不包含凭证"
          },
          "cardReference": {
            "type": "string",
            "description": "非秘密交付记录引用；知办必须经原申请人的可信会话再次鉴权才能领取"
