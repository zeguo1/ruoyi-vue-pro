  "components": {
    "securitySchemes": {
      "MgsTrialSignature": {
        "type": "apiKey",
        "description": "仅限 HTTPS 安全请求的 HMAC-SHA256 服务签名，不是静态 API Key。可信会话身份、MGS 短信验证凭据和签名头由服务端注入；新申请使用 mgs-trial-v2。",
        "name": "X-Mgs-Trial-Signature",
        "in": "header"
      }
    },
    "schemas": {
      "cn.iocoder.yudao.framework.common.pojo.CommonResultCn.iocoder.yudao.module.crm.controller.admin.trial.vo.TrialGuideRespVO": {
        "type": "object",
        "description": "通用返回",
        "properties": {
          "code": {
            "type": "integer",
            "format": "int32",
            "description": "业务状态码，0 表示成功，非 0 表示失败；不能只依据 HTTP 状态判断成功",
            "example": 0
          },
          "msg": {
            "type": "string",
            "description": "业务结果说明；失败时为可阅读的错误原因"
          },
          "data": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/cn.iocoder.yudao.module.crm.controller.admin.trial.vo.TrialGuideRespVO",
                "description": "业务结果数据，结构由具体接口定义"
              },
              {
                "type": "null"
              }
            ],
            "description": "业务结果数据，结构由具体接口定义"
          }
        },
        "required": [
          "code"
        ]
      },
      "cn.iocoder.yudao.module.crm.controller.admin.trial.vo.TrialGuideRespVO": {
        "type": "object",
        "description": "本人业务体验说明，只返回已准备的真实资源引用，不包含凭据",
        "properties": {
          "accountReady": {
            "type": "boolean",
            "default": false,
            "description": "两侧账号及演示资源是否就绪"
